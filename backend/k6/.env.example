# Example environment variables for k6 tests
# Copy this file to `.env` or export variables before running k6

# Base URL for your running backend
K6_BASE_URL=http://localhost:8080

# Academy slug used by public endpoints
ACADEMY_SLUG=my-abacus-academy

# Student credentials for authenticated tests (use a test account)
STUDENT_USERNAME=student1
STUDENT_PASSWORD=secret

# Exam ID to use for student flow tests
EXAM_ID=<exam-id-here>

# If you already have tokens you can use instead of credentials
#K6_STUDENT_JWT=eyJ...your_jwt_here
#K6_CLERK_TOKEN=eyJ...your_clerk_token_here
