# Frontend Environment Variables

# API Base URL
VITE_API_BASE_URL=http://localhost:30000

# ========================================
# 🔧 DEV AUTH BYPASS (DEVELOPMENT ONLY)
# ========================================
# Set to 'true' to skip authentication for testing
# ⚠️  NEVER deploy with this enabled!
VITE_DEV_AUTH_BYPASS=true

# ========================================
# 🔐 CLERK AUTHENTICATION (PRODUCTION)
# ========================================
# Get this from: https://dashboard.clerk.com → Your App → API Keys
# Clerk Publishable Key (for teacher authentication)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
